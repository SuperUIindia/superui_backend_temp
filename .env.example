# ============================================================================
# AKHILTHADAKA (SuperUI) - backend runtime configuration TEMPLATE
#
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Rule: ports, hosts, origins, URLs and the admin credentials live ONLY in
# `.env`. Application code never hard-codes them (see src/config/env.js).
# A missing value fails loudly instead of silently falling back to localhost.
# ============================================================================

# --- Server ----------------------------------------------------------------
NODE_ENV=development

# TCP port the API binds to. Required.
PORT=5000

# Public origin of the frontend. Required. Drives CORS, canonical URLs and the
# links inside transactional email.
CLIENT_URL=http://localhost:5173

# Canonical site URL used for SEO tags, sitemap and structured data.
SITE_URL=http://localhost:5173

# Externally reachable API origin (tooling, health output, SEO).
API_PUBLIC_URL=http://localhost:5000

# --- CORS ------------------------------------------------------------------
# Every browser origin allowed to call this API. CLIENT_URL is always allowed.
# Exact origins, or a wildcard suffix such as *.vercel.app for preview deploys.
CORS_ORIGINS=http://localhost:5173

# Escape hatch for local debugging only. NEVER true in production.
CORS_ALLOW_ANY=false

# Express trust-proxy hops, required for correct client IPs behind Render/CDN.
# true | false | number of hops
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# Required. Local: mongodb://127.0.0.1:27017/superui
#             Atlas: mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
MONGODB_URI=mongodb://127.0.0.1:27017/superui

# Source connection string for `npm run migrate:atlas` (local -> Atlas).
# LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/superui

# Read-only second connection string used only by `npm run verify:isolation`.
# SHARED_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/superui_core

# Public DNS resolvers. Some networks (corporate/ISP DNS, Windows default
# resolver) cannot answer SRV lookups, which makes mongodb+srv:// fail with
# "querySrv ECONNREFUSED". Set these to force a resolver that can.
DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Security & Authentication --------------------------------------------
# Required. Long, random, unique per environment.
JWT_SECRET=generate-a-long-random-string-here
IP_HASH_SALT=generate-a-different-long-random-string-here

# Admin session cookie policy.
#   lax    - API and frontend are same-site (local development, single domain)
#   none   - API and frontend are on different sites (requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# --- Admin bootstrap credentials ------------------------------------------
# Consumed ONLY by `npm run seed:admin` and the verification scripts.
# Never hard-coded, never bundled into the frontend, never logged.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-admin-password

# --- Branding --------------------------------------------------------------
BRAND_NAME=AKHILTHADAKA

# --- Email / SMTP (optional) ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AKHILTHADAKA" <noreply@your-domain.com>
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com

# --- Public business coordinates (SEO / AEO / GEO signals) ----------------
CONTACT_EMAIL=hello@your-domain.com
CONTACT_PHONE=+910000000000
BUSINESS_CITY=Your City
BUSINESS_REGION=Your Region
BUSINESS_REGION_CODE=IN-XX
BUSINESS_COUNTRY=IN
BUSINESS_COUNTRY_NAME=India
BUSINESS_POSTAL_CODE=000000
BUSINESS_LATITUDE=0.0000
BUSINESS_LONGITUDE=0.0000
