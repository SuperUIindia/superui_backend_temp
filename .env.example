# ============================================================================
# SuperUI - backend runtime configuration (example)
# ============================================================================
# Copy this file to .env and fill in the REAL values. .env is git-ignored.
# Never commit real secrets. This file exists so a fresh clone can be built
# without guessing what variables are needed.
# ============================================================================

# --- Database ---------------------------------------------------------------
# MongoDB connection string. Required.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/superui?retryWrites=true&w=majority

# --- Public URLs ------------------------------------------------------------
# Public origin of the frontend. Required. Used for CORS, canonical URLs,
# transactional email links and admin dashboard deep links.
CLIENT_URL=https://superui.in

# Public API origin. Optional; defaults to CLIENT_URL. Used by tooling and the
# health endpoint. Never set this to a localhost or 127.0.0.1 value - it is
# logged in startup output and must describe the real deployment.
API_PUBLIC_URL=

# Extra browser origins allowed to call the API. Comma-separated. CLIENT_URL is
# always allowed. Entries may be exact origins ("https://staging.example.com")
# or a wildcard suffix ("*.vercel.app"). Never include a trailing slash - the
# origin matcher compares against the raw Origin header, which has no slash.
CORS_ORIGINS=https://www.superui.in

# Allow any origin. NEVER enable this in production.
CORS_ALLOW_ANY=false

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=production
TRUST_PROXY=false

# --- Security ---------------------------------------------------------------
# Secret used to sign the admin session cookie. Required. Must be at least 32
# characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_generate_a_random_32_char_secret

# Salt used to hash visitor IP addresses before storage. Required.
IP_HASH_SALT=change_me_generate_a_random_salt

# --- Admin bootstrap --------------------------------------------------------
# The single admin account. Required to run `npm run seed:admin`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!StrongPassword

# --- Session cookie ---------------------------------------------------------
# SameSite policy. "lax" when the API is same-site with the frontend (local
# dev), "none" (which forces Secure) when they are on different sites in
# production. Never leave this unset in production.
COOKIE_SAME_SITE=lax

# Whether the session cookie is Secure. When SameSite=None this MUST be true.
# When unset, defaults to true in production.
COOKIE_SECURE=

# --- Email ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello.superui@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SuperUI Team" <hello.superui@gmail.com>

# Destination for the rich, icon-led "New Lead" notification sent on every
# submission. Distinct from ADMIN_NOTIFICATION_EMAIL so the alert can be routed
# to the owner without changing the reply-to address.
LEAD_NOTIFICATION_EMAIL=akhilthadaka97@gmail.com
ADMIN_NOTIFICATION_EMAIL=hello.superui@gmail.com

# --- Branding ----------------------------------------------------------------
BRAND_NAME=SuperUI
SITE_URL=https://superui.in/

# --- Optional ---------------------------------------------------------------
# Public DNS resolvers, needed when the host resolver cannot answer the SRV
# queries that mongodb+srv:// requires (common on corporate/ISP/Windows DNS).
DNS_SERVERS=8.8.8.8,1.1.1.1