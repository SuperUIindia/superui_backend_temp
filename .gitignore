# ============================================================================
# SuperUI backend - ignore rules
#
# The critical entry is `.env`: it holds MONGODB_URI, JWT_SECRET, IP_HASH_SALT,
# the admin username/password and the SMTP password. Committing it hands a
# complete takeover of the database and the admin panel to anyone who clones.
# `.env.example` carries the same keys with placeholder values and IS committed.
# ============================================================================

# --- Secrets (NEVER COMMIT) ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
service-account*.json
secrets.json

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Logs ------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Caches ----------------------------------------------------------------
.cache/
.parcel-cache/
.temp/
.tmp/
tmp/
.nyc_output/
coverage/
test-results/
*.tsbuildinfo

# --- Test / spec files -----------------------------------------------------
# Not needed in the deployment repository.
test/
tests/
__tests__/
spec/
*.spec.js
*.spec.ts
*.test.js
*.test.ts

# --- Deployment / platform --------------------------------------------------
.vercel
.netlify
.render
*.firebase
firebase-debug.log

# --- Editors ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Misc ------------------------------------------------------------------
build-info.txt
npm-debug.log*

# package-lock.json IS committed on purpose: the deployment must install the
# exact audited dependency tree. yarn.lock and pnpm-lock.yaml are not used.
yarn.lock
pnpm-lock.yaml