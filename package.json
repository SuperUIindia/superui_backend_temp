{
  "name": "superui-backend",
  "version": "1.0.0",
  "description": "SuperUI Services API — Express 5 + MongoDB backend for lead generation, telemetry and admin analytics",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedAdmin.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:services": "node scripts/syncServicesToDb.js",
    "seed:sections": "node scripts/syncSectionsToDb.js",
    "migrate:atlas": "node scripts/migrateToAtlas.js",
    "cleanup:shared-db": "node scripts/cleanupSharedDb.js",
    "verify:catalogue": "node scripts/verifyCatalogue.js",
    "verify:forms": "node scripts/verifyFormSubmissions.js",
    "verify:isolation": "node scripts/verifyIsolation.js",
    "verify:popups": "node scripts/verifyPopups.js"
  },
  "keywords": [
    "superui",
    "express",
    "mongodb",
    "api"
  ],
  "author": "SuperUI Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.14",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
