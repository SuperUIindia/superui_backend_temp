# ============================================================================
# SuperUI - Backend Production Environment Variables (.env.production.example)
# ============================================================================
# Configure these variables in your production host environment (e.g., Render)
# ============================================================================

# --- Server & Runtime --------------------------------------------------------
PORT=5000
NODE_ENV=production
# Render acts as a single reverse proxy hop. Set to 1 so req.ip and rate limiters work properly.
TRUST_PROXY=1

# --- Database ----------------------------------------------------------------
# MongoDB Atlas connection string. Make sure Atlas Network Access allows your host IPs (or 0.0.0.0/0).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/superui?retryWrites=true&w=majority

# --- Frontend & CORS Origins -------------------------------------------------
# The canonical public URL of your frontend.
CLIENT_URL=https://superui.in

# Additional allowed origins (exact URLs, comma-separated, no trailing slash).
# In production, wildcards (*.vercel.app) are disabled for cookie security.
CORS_ORIGINS=https://www.superui.in

# Public API origin (informational / health output).
API_PUBLIC_URL=https://superui-backend-temp.onrender.com

# --- Security & Session ------------------------------------------------------
# Secret used to sign admin session JWT tokens. Must be at least 32 characters!
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_random_cryptographic_secret_at_least_32_characters_long

# Salt used to SHA-256 hash visitor IPs before storing telemetry.
# Generate using: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
IP_HASH_SALT=generate_a_random_salt_for_ip_hashing

# Cookie SameSite policy:
# "lax" is recommended when using subdomain topology (api.superui.in and superui.in share the domain).
# "none" is required if frontend and backend live on entirely separate domains (requires COOKIE_SECURE=true).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# --- Admin Bootstrap ---------------------------------------------------------
# Admin credentials used when running `npm run seed:admin` once against the production database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_StrongPassword123!

# --- Email Notifications (SMTP) ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello.superui@gmail.com
# If using Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-google-app-password
SMTP_FROM="SuperUI Team" <hello.superui@gmail.com>

# Destination where client lead alert emails are sent:
LEAD_NOTIFICATION_EMAIL=akhilthadaka97@gmail.com
ADMIN_NOTIFICATION_EMAIL=hello.superui@gmail.com

# --- Branding ----------------------------------------------------------------
BRAND_NAME=SuperUI
SITE_URL=https://superui.in

